# Production selects API mode. The base URL stays empty until the backend contract exists.
# API mode shows a configuration error and does not fall back to mock data.
# Do not put secrets in this file.
VITE_DATA_MODE=api
VITE_API_BASE_URL=

# Used only when VITE_DATA_MODE=api. Leave blank until the API contract is known.
VITE_API_LOGIN_PATH=
VITE_API_LOGOUT_PATH=
VITE_API_HEAD_OFFICES_PATH=
VITE_API_BRANCHES_PATH=
VITE_API_DASHBOARD_PATH=
VITE_API_LEDGERS_PATH=
VITE_API_LEDGER_GROUPS_PATH=
