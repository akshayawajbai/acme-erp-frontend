# Production selects API mode. Set VITE_API_BASE_URL to the deployed API origin.
# API mode shows a configuration error when the base URL is empty and does not fall back to mock.
# Do not put secrets, passwords, or JWTs in this file.
VITE_DATA_MODE=api
VITE_API_BASE_URL=

# Login path matches the published auth contract.
VITE_API_LOGIN_PATH=/api/auth/login

# Leave blank until each API contract is supplied.
VITE_API_LOGOUT_PATH=
VITE_API_HEAD_OFFICES_PATH=
VITE_API_BRANCHES_PATH=
VITE_API_DASHBOARD_PATH=
VITE_API_LEDGERS_PATH=
VITE_API_LEDGER_GROUPS_PATH=
