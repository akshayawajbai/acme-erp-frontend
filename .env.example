# Allowed values: mock | api. Any other value is a configuration error.
# The app does not fall back between modes.
# Do not put secrets, passwords, credentials, or JWTs in these variables.

# mock — demonstration offices and any non-empty password
# api  — real backend login at VITE_API_BASE_URL + VITE_API_LOGIN_PATH
VITE_DATA_MODE=api

# Absolute API origin only (no trailing path). Example for local backend:
#   VITE_API_BASE_URL=http://localhost:5118
# localhost points at the machine running the browser. For LAN access from
# another computer, use the backend computer's LAN IP and API port instead.
# Example shape: http://192.168.x.x:5118 — replace with the real IP; do not invent it.
# Backend CORS must allow the frontend origin, and the API port must be reachable.
VITE_API_BASE_URL=http://localhost:5118

# Login contract: POST { headOfficeCode, userName, password }
VITE_API_LOGIN_PATH=/api/auth/login

# Leave blank until each API contract is supplied. Do not invent endpoints.
VITE_API_LOGOUT_PATH=
VITE_API_HEAD_OFFICES_PATH=
VITE_API_BRANCHES_PATH=
VITE_API_DASHBOARD_PATH=
VITE_API_LEDGERS_PATH=
VITE_API_LEDGER_GROUPS_PATH=
