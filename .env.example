# Allowed values: mock | api. Any other value is a configuration error.
# Development (.env.development) uses mock. Production (.env.production) uses api.
# API mode requires VITE_API_BASE_URL and does not fall back to mock data.
# Do not put secrets or credentials in these variables.
VITE_DATA_MODE=mock
VITE_API_BASE_URL=

# Used only when VITE_DATA_MODE=api. Leave blank until the API contract is known.
VITE_API_LOGIN_PATH=
VITE_API_LOGOUT_PATH=
VITE_API_HEAD_OFFICES_PATH=
VITE_API_BRANCHES_PATH=
VITE_API_DASHBOARD_PATH=
VITE_API_LEDGERS_PATH=
VITE_API_LEDGER_GROUPS_PATH=
