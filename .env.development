# Development data mode. Change only VITE_DATA_MODE to switch static vs API.
#   mock — demonstration offices, dashboard, and ledger (no backend required)
#   api  — real login API (requires backend at VITE_API_BASE_URL)
# Do not put secrets, passwords, or JWTs in this file.
VITE_DATA_MODE=mock
VITE_API_BASE_URL=http://localhost:5118
VITE_API_LOGIN_PATH=/api/auth/login

# localhost works when the browser and backend run on the same computer.
# For LAN testing from another computer, set VITE_API_BASE_URL to this
# computer's LAN IP and the API port (for example http://192.168.x.x:5118).
# Do not invent the IP. Also configure backend CORS for the frontend origin
# and allow the API port through the firewall.

# Leave blank until each API contract is supplied.
VITE_API_LOGOUT_PATH=
VITE_API_HEAD_OFFICES_PATH=
VITE_API_BRANCHES_PATH=
VITE_API_DASHBOARD_PATH=
VITE_API_LEDGERS_PATH=
VITE_API_LEDGER_GROUPS_PATH=
